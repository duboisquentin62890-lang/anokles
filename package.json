{
  "name": "tkr",
  "version": "1.0.0",
  "private": true,
  "description": "TKR — site vente/download + bot Discord + panel admin",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run web\"",
    "server": "node server/index.js",
    "web": "npm run dev --prefix web",
    "start": "node server/index.js",
    "build": "npm install --prefix web && npm run build --prefix web",
    "setup": "npm install && npm install --prefix web",
    "register-commands": "node server/bot/register.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.8",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
